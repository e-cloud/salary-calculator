{
  "name": "salary-calculator",
  "version": "0.1.0",
  "description": "a monorepo for salary calculator with various frontend solutions",
  "scripts": {
    "format": "prettier --config-precedence file-override --write",
    "format:all": "prettier --loglevel error --config-precedence file-override --write ./**/*.{ts,tsx,js,json,jsx,vue,scss,css,yml,yaml}",
    "release": "commit-and-tag-version -a",
    "prepare": "husky"
  },
  "private": true,
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "commit-and-tag-version": "^13.1.2",
    "cross-env": "^7.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6"
  }
}
