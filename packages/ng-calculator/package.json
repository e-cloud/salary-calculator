{
  "name": "ng-calculator",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "ng lint",
    "lint:style": "stylelint src/**/*.{scss,css} --fix",
    "format": "prettier --config-precedence file-override --write",
    "format:all": "prettier --loglevel error --config-precedence file-override --write ./src/**/**.{html,ts,js,json,scss,css}",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:report": "playwright show-report",
    "release": "npm run build -- --configuration production --base-href /salary-calculator/",
    "deploy": "gh-pages --dist dist/salary-calculator"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.22",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.22",
    "@angular/compiler": "^21.2.22",
    "@angular/core": "^21.2.22",
    "@angular/forms": "^21.2.22",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.2.22",
    "@angular/platform-browser-dynamic": "^21.2.22",
    "@angular/router": "^21.2.22",
    "@ngrx/signals": "^21.1.1",
    "bootstrap": "^4.6.1",
    "calculator-core": "workspace:*",
    "echarts": "^5.6.0",
    "lodash-es": "^4.17.21",
    "ngx-echarts": "^21.0.0",
    "rxjs": "^7.8.1",
    "tslib": "^2.8.1",
    "zrender": "^5.6.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.22",
    "@angular-eslint/builder": "^21.4.0",
    "@angular-eslint/eslint-plugin": "^21.4.0",
    "@angular-eslint/eslint-plugin-template": "^21.4.0",
    "@angular-eslint/schematics": "^21.4.0",
    "@angular-eslint/template-parser": "^21.4.0",
    "@angular/cli": "^21.2.22",
    "@angular/compiler-cli": "^21.2.22",
    "@playwright/test": "^1.50.1",
    "@testing-library/angular": "^19.4.2",
    "@testing-library/user-event": "^14.5.2",
    "@types/lodash": "^4.17.16",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.5.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-unused-imports": "^3.2.0",
    "gh-pages": "^6.2.0",
    "jsdom": "^25.0.0",
    "postcss": "^8.4.45",
    "prettier": "^3.9.6",
    "stylelint": "~14.6.0",
    "stylelint-config-prettier": "^9.0.3",
    "stylelint-config-standard": "~25.0.0",
    "stylelint-config-standard-scss": "^3.0.0",
    "stylelint-order": "~5.0.0",
    "stylelint-scss": "~4.2.0",
    "typescript": "~5.9.3",
    "vitest": "^2.1.8",
    "vitest-canvas-mock": "^1.1.5"
  }
}
